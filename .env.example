# Never commit a real API key. Create a new xAI key after revoking exposed keys.
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
XAI_API_KEY=
GROK_MODEL=grok-4.6
DATABASE_URL=sqlite:///./data/aster.db
# For production, point these to managed services.
QDRANT_URL=
QDRANT_API_KEY=
CORS_ORIGINS=http://localhost:8000
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
