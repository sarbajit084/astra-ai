# ==============================================================================
# Astra RAG + AI Agent - Production Environment Configuration Template
# Copy this file to .env and replace placeholders with your real values.
# IMPORTANT: NEVER commit your real .env file or share it publicly!
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production
LOG_LEVEL=INFO

# Security & JWT Authentication
# Generate a strong 64-character random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=your-production-super-secret-jwt-key-change-this-now

# Database Connection
# Default: Local SQLite database stored safely in data/ directory
DATABASE_URL=sqlite:///data/aster.db
# For Enterprise PostgreSQL (optional, highly recommended for 100k+ users):
# DATABASE_URL=postgresql+psycopg://astra_user:your_db_password@localhost:5432/astra_db

# LLM Providers Configuration (Provide at least ONE: Groq or Grok)
# Groq Cloud API (Get free/fast key from: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# xAI Grok API (Get key from: https://console.x.ai)
GROK_API_KEY=xai_your_xai_api_key_here
GROK_MODEL=grok-2-latest

# Qdrant Vector Database (Optional - defaults to embedded in-memory/disk store)
# If using Qdrant Cloud cluster:
# QDRANT_URL=https://your-cluster-id.qdrant.tech:6333
# QDRANT_API_KEY=your-qdrant-api-key

# Neural Embeddings & Reranking Models
# Set to true if you have at least 4GB RAM on your server and want local HuggingFace neural models
USE_NEURAL_MODELS=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Trusted CORS Origins (Comma-separated list of allowed domains)
# Replace with your actual GoDaddy server domain and any client web/app origins:
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com,http://localhost:8000

# File Upload & Document Ingestion Limit
# Default: 400 MB (419430400 bytes)
MAX_UPLOAD_BYTES=419430400

# Gunicorn / Server Performance Tuning
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=300
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Email (SMTP) Dispatch Configuration (Optional - for password recovery notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
SMTP_USE_TLS=true

# SMS Gateway Configuration (Optional - Fast2SMS or Twilio)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
