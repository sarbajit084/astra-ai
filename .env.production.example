# Astra AI Production Environment Configuration
APP_ENV=production
LOG_LEVEL=INFO

# Authentication Secrets (Generate a long random string for production)
JWT_SECRET=production-secret-aster-enterprise-secure-2026-key-salt

# LLM Providers (At least one key is required)
GROQ_API_KEY=gsk_your_groq_api_key_here
XAI_API_KEY=xai_your_xai_api_key_here

# Models (default: openai/gpt-oss-120b or grok-2-latest)
GROQ_MODEL=openai/gpt-oss-120b
GROK_MODEL=grok-2-latest

# Vector DB (Optional: Leave blank to use local embedded storage or provide Qdrant Cloud URL)
QDRANT_URL=
QDRANT_API_KEY=

# Database URL (Leave blank to use persistent SQLite in /app/data/aster.db or specify PostgreSQL)
DATABASE_URL=

# CORS - Set to * to allow web and mobile app access from anywhere
CORS_ORIGINS=*

# Feature toggles
USE_NEURAL_MODELS=false
